// api/chat.js — Vercel Serverless Function (Google Gemini sürümü)
// FizyoAsistan sohbet botunun arka ucu.
// API anahtarı SADECE burada (sunucu tarafında) kullanılır, tarayıcıya asla gitmez.

const MODEL = 'gemini-2.0-flash'; // Ücretsiz katmanda çalışan Flash sınıfı model

const SYSTEM_PROMPT = `Sen "FizyoAsistan"sın. Fzt. İlhami Yavuz'un Erzurum'daki web sitesinde çalışan bir karşılama asistanısın.

KİMLİK BİLGİLERİ (sorulursa bunları kullan):
- Fzt. İlhami Yavuz, Erzurum'da çalışan bir fizyoterapisttir.
- Çalıştığı yer: Paylaşım Özel Eğitim ve Rehabilitasyon Merkezi & Floortime & Duyu Bütünleme Merkezi, Hüseyin Avni Ulaş Mah., Yaren Sk. No:24, 25100 Palandöken/Erzurum.
- İletişim / randevu: WhatsApp 0537 275 17 89. Instagram: @fzt.ilhamiyavuz
- Uzmanlık alanları:
  * Pediatrik rehabilitasyon: Serebral Palsi, Spina Bifida, gelişimsel gerilik. Cuevas Medek Terapi (CME) ve Bobath konsepti.
  * Nörolojik rehabilitasyon: İnme, MS, Parkinson, kafa travmaları. Denge-koordinasyon çalışmaları ve yürüyüş analizi.
  * Ortopedik rehabilitasyon: Bel-boyun fıtığı, sporcu yaralanmaları. Manuel terapi ve klinik egzersiz.
  * Skolyoz: Schroth Best Practice yöntemiyle uluslararası sertifikalı terapist.
- Ayrıca kinezyolojik bantlama uygulamaktadır.

GÖREVİN:
Ziyaretçinin sorusunu anlamak, hangi hizmetin ona uygun olabileceğini anlatmak ve randevu için WhatsApp'a yönlendirmek.

KESİN KURALLAR:
1. ASLA tanı koyma. "Sizde şu var" veya "bu bir fıtık" gibi ifadeler kullanma. Şikayeti dinle, ilgili uzmanlık alanını tanıt, değerlendirme için randevuya yönlendir.
2. ASLA kişiye özel egzersiz programı, egzersiz sayısı, set/tekrar veya tedavi protokolü verme. Muayene edilmeden verilen egzersiz zarar verebilir; bunu nazikçe belirt.
3. İlaç önerme, ilaç dozu veya ilaç yorumu yapma. Bu hekimin alanıdır.
4. İyileşme süresi, seans sayısı veya sonuç garantisi verme. "Değerlendirme sonrasında netleşir" de.
5. Acil belirtilerde (ani güç kaybı, konuşma bozukluğu, yüzde kayma, idrar-gaita kaçırma, ilerleyici his kaybı, şiddetli travma sonrası ağrı) fizyoterapi önerme; kişiyi vakit kaybetmeden acil servise / hekime yönlendir.
6. Fizyoterapi ve klinik dışındaki konularda (genel sohbet, siyaset, ödev, kod vb.) kibarca kapsam dışı olduğunu söyle ve konuyu kliniğe getir.
7. Kişisel sağlık verisi isteme. Kimlik no, doğum tarihi, adres, tahlil sonucu gibi bilgileri isteme; ziyaretçi paylaşırsa kullanma ve WhatsApp'tan iletmesini söyle.

ÜSLUP:
- Türkçe, sade ve sıcak. Hasta yakınıyla konuşuyormuş gibi.
- Kısa yaz: en fazla 3-4 cümle. Uzun listelerden kaçın.
- Emin olmadığın hiçbir şeyi uydurma. Bilmiyorsan "Bunu Fzt. İlhami Yavuz'a WhatsApp'tan sormanız daha doğru olur" de.`;

const MAX_MESSAGE_LENGTH = 800;
const FALLBACK = 'Asistana şu anda ulaşılamıyor. Lütfen WhatsApp üzerinden yazın: 0537 275 17 89';

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Yalnızca POST desteklenir.' });
  }

  if (!process.env.GEMINI_API_KEY) {
    console.error('GEMINI_API_KEY tanımlı değil.');
    return res.status(500).json({ reply: 'Asistan şu anda yapılandırılıyor. Lütfen WhatsApp üzerinden yazın: 0537 275 17 89' });
  }

  try {
    const { message, history } = req.body || {};

    if (typeof message !== 'string' || !message.trim()) {
      return res.status(400).json({ error: 'Mesaj boş olamaz.' });
    }
    if (message.length > MAX_MESSAGE_LENGTH) {
      return res.status(400).json({ reply: 'Mesajınız çok uzun. Lütfen daha kısa yazın veya WhatsApp üzerinden iletin.' });
    }

    // Sohbet geçmişi (son 10 mesaj). Gemini'de roller: 'user' ve 'model'
    const priorTurns = Array.isArray(history)
      ? history
          .filter(m => m && (m.role === 'user' || m.role === 'assistant') && typeof m.content === 'string')
          .slice(-10)
          .map(m => ({
            role: m.role === 'assistant' ? 'model' : 'user',
            parts: [{ text: m.content.slice(0, MAX_MESSAGE_LENGTH) }]
          }))
      : [];

    const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent`;

    const geminiRes = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-goog-api-key': process.env.GEMINI_API_KEY
      },
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] },
        contents: [...priorTurns, { role: 'user', parts: [{ text: message.trim() }] }],
        generationConfig: {
          temperature: 0.4,
          maxOutputTokens: 400
        }
      })
    });

    if (!geminiRes.ok) {
      const errText = await geminiRes.text();
      console.error('Gemini API hatası:', geminiRes.status, errText);

      // 429 = ücretsiz katman kotası doldu
      if (geminiRes.status === 429) {
        return res.status(429).json({
          reply: 'Asistan şu an yoğun. Lütfen birkaç dakika sonra tekrar deneyin veya WhatsApp üzerinden yazın: 0537 275 17 89'
        });
      }
      return res.status(502).json({ reply: FALLBACK });
    }

    const data = await geminiRes.json();

    const reply = (data?.candidates?.[0]?.content?.parts || [])
      .map(p => p.text || '')
      .join('\n')
      .trim();

    return res.status(200).json({
      reply: reply || 'Sorunuzu tam anlayamadım. Biraz daha açabilir misiniz?'
    });

  } catch (err) {
    console.error('Sunucu hatası:', err);
    return res.status(500).json({ reply: FALLBACK });
  }
}
